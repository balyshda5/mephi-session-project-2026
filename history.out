  330  sudo tee /etc/nginx/conf.d/mephi-web.conf > /dev/null  << 'EOF'
server {
listen 80 default_server;
listen [::]:80 default_server;

server_name _;

root /mephi-web;
index index.html;

location / {
try_files $uri $uri/ =404;
}
}
EOF

